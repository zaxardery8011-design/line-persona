# LINE Messaging API channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Messaging API channel secret
LINE_CHANNEL_SECRET=

# 1:1 chats: seconds of the LINE loading animation while the reply is prepared (empty = 20, 0 = off; rounded up to a multiple of 5 within 5-60)
LINE_LOADING_SECONDS=

# Local server port
PORT=3000

# Webhook guard: max request body in bytes, checked against Content-Length before the signature; larger gets 413 (empty = 262144, 0 = no limit)
WEBHOOK_MAX_BODY_BYTES=
# Webhook guard: messages per LINE user per window; extra ones are dropped without calling the model or replying (empty = 20, 0 = no limit)
WEBHOOK_RATE_LIMIT_MAX=
# Webhook guard: length of that window in seconds (empty = 60)
WEBHOOK_RATE_LIMIT_WINDOW_SEC=

# OpenAI-compatible chat completions endpoint base URL
LLM_BASE_URL=

# API key for your LLM provider. Local Ollama can leave this empty.
LLM_API_KEY=

# Model name used by your provider
LLM_MODEL=

# Cloud example: OpenAI-compatible provider
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-api-key
# LLM_MODEL=gpt-4.1-mini

# Cloud example: Gemini or Claude through an OpenAI-compatible gateway
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=your-gateway-api-key
# LLM_MODEL=gemini-2.5-flash

# Cloud example: xAI Grok (OpenAI-compatible, no gateway needed)
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-your-api-key
# LLM_MODEL=grok-4.7

# Local example: Ollama OpenAI-compatible endpoint
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1


# --- Optional features: all off when empty (identical to v0.1.0). See AGENTS.md ---
# Human handoff / escalation
ESCALATION_ENABLED=
ESCALATION_NOTIFY_TO=
ESCALATION_NOTIFY_SKIP_ASKER=
ESCALATION_TRIGGERS=
ESCALATION_DEDUPE_MIN=
ESCALATION_MAX_REMINDERS=
ESCALATION_ACK_TEXT=
# Push attempts on a network error, timeout or LINE 5xx (empty = 3, max 5; 1 = no retry and no X-Line-Retry-Key)
ESCALATION_PUSH_ATTEMPTS=
# Wait before the first push retry in ms, doubled each retry (empty = 500, max 5000); retries only start within 10 s of the first attempt
ESCALATION_PUSH_RETRY_MS=
# Group feed: GROUP_MODE = reply | mention | silent
GROUP_MODE=
GROUP_WAKE_WORDS=
GROUP_COLLECT=
# "Forget me" command words, |-separated (empty = 忘了我); on when GROUP_COLLECT=1 or this is set. The whole message must match,
# and nothing is deleted until the sender replies 確定 in the same chat within 60 s
GROUP_FORGET_WORDS=
# Multi-turn memory (in-memory only, cleared on restart)
HISTORY_TURNS=
HISTORY_TTL_MIN=
HISTORY_CLEAR_WORDS=
